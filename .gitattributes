# Normalize all text files to LF on every platform (checkout and commit).
# This is enforced by git itself, so per-machine core.autocrlf settings and
# editor defaults can never reintroduce CRLF into the working tree.
* text=auto eol=lf

# Explicit binary exceptions — never normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
